# Все текстовые файлы храним с LF: Shadowrocket и валидатор ожидают Unix-переводы строк.
* text=auto eol=lf
*.list text eol=lf
*.conf text eol=lf
*.module text eol=lf
*.py text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
# Индекс правил собирает github_actions/build_rule_index.py: GitHub сворачивает его в диффах.
Script/rule-index/** linguist-generated=true
