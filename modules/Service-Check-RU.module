#!name=Проверка сервисов
#!desc=Страница http://sr.test в Safari, сертификат не нужен: проверка любого адреса по правилам конфига (напрямую, через прокси или блокируется), IP напрямую и через прокси, доступность сайтов и работа YouTube Premium, ChatGPT, Netflix, Spotify, TikTok и других сервисов через текущий сервер. Работает и при типе прокси HTTP, и при None. Адрес https://sr.test тоже работает, если включена HTTPS-расшифровка.
#!homepage=https://github.com/newzealandgrom/Shadowrocket-routing
# Страница, проверка адреса по правилам, маршрута и сайтов: Script/service-check.js этого репозитория.
# Проверки отдельных сервисов: скрипты huskydsb/Shadowrocket (https://github.com/huskydsb/Shadowrocket),
# их ответы страница переводит на русский. Утечку DNS проверяет Script/service-check.js через surfsharkdns.com.

[General]
# Обычный http://sr.test обрабатывается без расшифровки и без сертификата.
force-http-engine-hosts = %APPEND% sr.test

[Script]
sr-check = type=http-request,pattern=^https?:\/\/sr\.test\/(route|sites|rule|probe|dns)?\/?(\?.*)?$,script-path=https://raw.githubusercontent.com/newzealandgrom/Shadowrocket-routing/refs/heads/master/Script/service-check.js,timeout=60
sr-check-youtube = type=http-request,pattern=^https?:\/\/sr\.test\/youtube\/?$,script-path=https://raw.githubusercontent.com/huskydsb/Shadowrocket/main/Streaming/js/youtube.js,timeout=60
sr-check-chatgpt = type=http-request,pattern=^https?:\/\/sr\.test\/chatgpt\/?$,script-path=https://raw.githubusercontent.com/huskydsb/Shadowrocket/main/Streaming/js/chatgpt.js,timeout=60
sr-check-netflix = type=http-request,pattern=^https?:\/\/sr\.test\/netflix\/?$,script-path=https://raw.githubusercontent.com/huskydsb/Shadowrocket/main/Streaming/js/netflix.js,timeout=60
sr-check-spotify = type=http-request,pattern=^https?:\/\/sr\.test\/spotify\/?$,script-path=https://raw.githubusercontent.com/huskydsb/Shadowrocket/main/Streaming/js/spotify.js,timeout=60
sr-check-tiktok = type=http-request,pattern=^https?:\/\/sr\.test\/tiktok\/?$,script-path=https://raw.githubusercontent.com/huskydsb/Shadowrocket/main/Streaming/js/tiktok.js,timeout=60
sr-check-disney = type=http-request,pattern=^https?:\/\/sr\.test\/disney\/?$,script-path=https://raw.githubusercontent.com/huskydsb/Shadowrocket/main/Streaming/js/disney.js,timeout=60
sr-check-primevideo = type=http-request,pattern=^https?:\/\/sr\.test\/primevideo\/?$,script-path=https://raw.githubusercontent.com/huskydsb/Shadowrocket/main/Streaming/js/primevideo.js,timeout=60
sr-check-steam = type=http-request,pattern=^https?:\/\/sr\.test\/steam\/?$,script-path=https://raw.githubusercontent.com/huskydsb/Shadowrocket/main/Streaming/js/steam.js,timeout=60
sr-check-googleplay = type=http-request,pattern=^https?:\/\/sr\.test\/googleplay\/?$,script-path=https://raw.githubusercontent.com/huskydsb/Shadowrocket/main/Streaming/js/googleplay.js,timeout=60
sr-check-bing = type=http-request,pattern=^https?:\/\/sr\.test\/bing\/?$,script-path=https://raw.githubusercontent.com/huskydsb/Shadowrocket/main/Streaming/js/bing.js,timeout=60
sr-check-wikipedia = type=http-request,pattern=^https?:\/\/sr\.test\/wikipedia\/?$,script-path=https://raw.githubusercontent.com/huskydsb/Shadowrocket/main/Streaming/js/wikipedia.js,timeout=60
sr-check-scamalytics = type=http-request,pattern=^https?:\/\/sr\.test\/scamalytics\/?$,script-path=https://raw.githubusercontent.com/huskydsb/Shadowrocket/main/Streaming/js/scamalytics.js,timeout=60

[Host]
# При типе прокси None (режим TUN) Safari сначала сам ищет адрес sr.test в DNS. Профиль с
# always-real-ip = * отдаёт только настоящие ответы, а домена sr.test в интернете нет, поэтому без
# этой записи Safari пишет, что не может открыть страницу. Запись даёт домену адрес, и запрос доходит
# до Shadowrocket. До самого 1.2.3.4 он не уходит: страницу отдаёт скрипт модуля.
sr.test = 1.2.3.4

[MITM]
hostname = %APPEND% sr.test
