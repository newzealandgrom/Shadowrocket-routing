#!name = Video Download Button
#!desc = Кнопка "Скачать видео" для Rutube/xHamster (YouTube не поддерживается — blob-плеер)
#!category = Tools
#!author = you

[Script]
video-download-button = type=http-response,pattern=^https?:\/\/(www\.)?(rutube\.ru|xhamster\.com|xhamster2\.com|xhamster3\.com)\/.*,requires-body=true,max-size=0,script-update-interval=0,script-path=https://raw.githubusercontent.com/newzealandgrom/Shadowrocket-routing/master/video-download-button.js,tag=video-download-button

[MITM]
hostname = %APPEND% rutube.ru, www.rutube.ru, xhamster.com, www.xhamster.com, xhamster2.com, xhamster3.com
