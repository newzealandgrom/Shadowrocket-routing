#!name = Video Download Button
#!desc = Добавляет кнопку "Скачать видео" на страницах с <video> тегами
#!category = Tools
#!author = you

[Script]
video-download-button = type=http-response,pattern=^https?:\/\/.+\.(html?)?(\?.*)?$,requires-body=true,max-size=-1,script-path=https://github.com/newzealandgrom/Shadowrocket-routing/raw/refs/heads/master/Script/video-download-button.js,tag=video-download-button

[MITM]
hostname = %APPEND% *
